r=#FFFFFF;endArrow=blockThin;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="l_kenshu" target="x_wecom"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1350" y="659"/><mxPoint x="1350" y="930"/><mxPoint x="2070" y="930"/><mxPoint x="2070" y="490"/></Array></mxGeometry></mxCell><mxCell id="e41" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;jumpStyle=arc;jumpSize=8;strokeColor=#5A6B7F;strokeWidth=1.5;dashed=0;fontSize=11;fontColor=#5A6B7F;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;exitX=1;exitY=0.75;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="l_kenshu" target="x_zoom"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1365" y="678"/><mxPoint x="1365" y="938"/><mxPoint x="2080" y="938"/><mxPoint x="2080" y="580"/></Array></mxGeometry></mxCell><mxCell id="e42" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;jumpStyle=arc;jumpSize=8;strokeColor=#5A6B7F;strokeWidth=1.5;dashed=0;fontSize=11;fontColor=#5A6B7F;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="l_eigyo" target="x_eki"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="920" y="659"/><mxPoint x="920" y="948"/><mxPoint x="2100" y="948"/><mxPoint x="2100" y="670"/></Array></mxGeometry></mxCell><mxCell id="e43" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;jumpStyle=arc;jumpSize=8;strokeColor=#5A6B7F;strokeWidth=1.5;dashed=0;fontSize=11;fontColor=#5A6B7F;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;exitX=1;exitY=0.75;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="l_eigyo" target="x_loc"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="935" y="678"/><mxPoint x="935" y="956"/><mxPoint x="2115" y="956"/><mxPoint x="2115" y="858"/></Array></mxGeometry></mxCell><mxCell id="g44" value="凡例（線の色）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#5A6B7F;dashed=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=2;fontColor=#5A6B7F;fontSize=12;fontStyle=1;container=1;collapsible=0;pointerEvents=0;" vertex="1" parent="1"><mxGeometry x="60" y="1430" width="620" height="180" as="geometry"/></mxCell><mxCell id="t45" value="━━━" style="text;html=1;align=left;verticalAlign=middle;fontSize=14;fontStyle=1;fontColor=#1565C0;" vertex="1" parent="1"><mxGeometry x="80" y="1468" width="60" height="20" as="geometry"/></mxCell><mxCell id="t46" value="① ③ 同期リクエスト（本人確認・回収）" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontStyle=0;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="150" y="1468" width="520" height="20" as="geometry"/></mxCell><mxCell id="t47" value="━━━" style="text;html=1;align=left;verticalAlign=middle;fontSize=14;fontStyle=1;fontColor=#2E7D32;" vertex="1" parent="1"><mxGeometry x="80" y="1496" width="60" height="20" as="geometry"/></mxCell><mxCell id="t48" value="② ⑥ S3 経路（提出・ダウンロード）" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontStyle=0;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="150" y="1496" width="520" height="20" as="geometry"/></mxCell><mxCell id="t49" value="━━━" style="text;html=1;align=left;verticalAlign=middle;fontSize=14;fontStyle=1;fontColor=#E65100;" vertex="1" parent="1"><mxGeometry x="80" y="1524" width="60" height="20" as="geometry"/></mxCell><mxCell id="t50" value="④ ⑦ ⑧ EventBridge 起動（定期実行）" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontStyle=0;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="150" y="1524" width="520" height="20" as="geometry"/></mxCell><mxCell id="t51" value="━━━" style="text;html=1;align=left;verticalAlign=middle;fontSize=14;fontStyle=1;fontColor=#AD1457;" vertex="1" parent="1"><mxGeometry x="80" y="1552" width="60" height="20" as="geometry"/></mxCell><mxCell id="t52" value="⑤ 既読確認 ／ push 配信" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontStyle=0;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="150" y="1552" width="520" height="20" as="geometry"/></mxCell><mxCell id="t53" value="━━━" style="text;html=1;align=left;verticalAlign=middle;fontSize=14;fontStyle=1;fontColor=#5A6B7F;" vertex="1" parent="1"><mxGeometry x="80" y="1580" width="60" height="20" as="geometry"/></mxCell><mxCell id="t54" value="経路（実線）／ 非同期 Invoke・参照（破線）" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontStyle=0;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="150" y="1580" width="520" height="20" as="geometry"/></mxCell><mxCell id="n55" value="処理フロー（線上の番号）&lt;br&gt;① 本人確認：「所属部署 お名前」→ roster 照合 → auth に当日認証（TTL＝当日限り）&lt;br&gt;② 提出：Excel / PDF / 画像 → S3 に保存し submissions に記録&lt;br&gt;③ 回収：総務が submissions の GSI1（月×種別）を Query して横断集計&lt;br&gt;④ 催促：EventBridge（25/28日）→ reminder →「社員チャネルの token」で push&lt;br&gt;⑤ 既読確認：社員が postback → broadcasts に記録（配信IDは画面に出さない）&lt;br&gt;⑥ ダウンロード：ZIP/CSV を exports/ に生成 → 署名付き短縮URL → presigned で取得&lt;br&gt;⑦ 予約催促：bookings を10分間隔のポーラーが拾い、実行時点の未提出者のみへ送信&lt;br&gt;⑧ 日次点検：毎日0:00 に到達性を確認し、到達不可なら紐付けを解除&lt;br&gt;&lt;br&gt;なぜ authType = NONE か&lt;br&gt;LINE Platform は Webhook に SigV4 を付けられず、AWS_IAM にすると全リクエストが403。&lt;br&gt;AWS 層は通し、アプリ層で HMAC-SHA256 の署名検証を必ず行う（BS_INF-05 §3）。&lt;br&gt;→ チャネルシークレットの漏洩が単一障害点。SSM SecureString にのみ保持する。" style="shape=note;whiteSpace=wrap;html=1;size=16;fillColor=#FFF8D5;strokeColor=#D6C36A;fontColor=#3A3218;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="710" y="1430" width="720" height="330" as="geometry"/></mxCell><mxCell id="n56" value="早期対応を推奨する課題（BS_INF 横断）&lt;br&gt;① 企業微信の認証情報が Lambda 環境変数に平文　　　　【高】BS_INF-08 §4&lt;br&gt;② 全 DynamoDB / S3 が RemovalPolicy.DESTROY。&lt;br&gt;　 人事スタック削除で全社データ消失　　　　　　　　　【高】BS_INF-03 §7&lt;br&gt;③ /dl の署名に有効期限が無い（露出は最大3日）　　　　【中】BS_INF-04 §6&lt;br&gt;④ 60日超の月は Deep Archive で一括DLが失敗　　　　　【中】BS_INF-04 §5&lt;br&gt;⑤ IAM が粗い（読み取りのみの関数にも DeleteItem）　　【中】BS_INF-07 §5&lt;br&gt;⑥ ログに氏名・社員番号が出力される　　　　　　　　　【中】BS_INF-09 §3&lt;br&gt;&lt;br&gt;※ 脆弱性検査（SAST / DAST）・ペネトレーションテストは未実施。&lt;br&gt;　 実施済みは機能面の単体・結合テストのみ。&lt;br&gt;&lt;br&gt;対応済（2026-09-19）：ログ保持期間 30日化・孤立ロググループ5件削除・&lt;br&gt;CloudWatch アラーム10件と SNS 通知の新設・デプロイ同期の機械検証。" style="shape=note;whiteSpace=wrap;html=1;size=16;fillColor=#FFF8D5;strokeColor=#D6C36A;fontColor=#3A3218;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="1460" y="1430" width="620" height="330" as="geometry"/></mxCell><mxCell id="n57" value="所有区分（スタック依存）&lt;br&gt;・BrightstarHr-dev（人事）が roster / auth /&lt;br&gt;　employees / submissions / S3 / SNS を所有。&lt;br&gt;　他4スタックは名前・ARN 文字列で参照する。&lt;br&gt;・初回デプロイは人事を最初に実行する。&lt;br&gt;・人事スタックの削除は他4チャネルを巻き込む。&lt;br&gt;・各チャネルは独立スタック＝&lt;br&gt;　障害・改修が他チャネルへ波及しない。&lt;br&gt;&lt;br&gt;スタック一覧&lt;br&gt;brightstar-kenshu-dev／BrightstarHr-dev／&lt;br&gt;BrightstarSoumu-dev／brightstar-shain-dev／&lt;br&gt;EkiCommute-dev" style="shape=note;whiteSpace=wrap;html=1;size=16;fillColor=#FFF8D5;strokeColor=#D6C36A;fontColor=#3A3218;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="2100" y="1430" width="460" height="330" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>